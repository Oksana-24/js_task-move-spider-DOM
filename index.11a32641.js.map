"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    if (e.target !== wall) return;
    var x = e.clientX;
    var y = e.clientY;
    var rect = wall.getBoundingClientRect();
    var leftBorder = rect.left;
    var topBorder = rect.top;
    var totalWidth = wall.clientWidth;
    var totalHeight = wall.clientHeight;
    var spider = document.querySelector(".spider");
    var spiderWidth = spider.clientWidth;
    var spiderHeight = spider.clientHeight;
    var newLeft = x - leftBorder - spiderWidth / 2;
    var newTop = y - topBorder - spiderHeight / 2;
    if (newLeft < 0) newLeft = 0;
    if (newLeft > totalWidth - spiderWidth) newLeft = totalWidth - spiderWidth;
    if (newTop < 0) newTop = 0;
    if (newTop > totalHeight - spiderHeight) newTop = totalHeight - spiderHeight;
    spider.style.top = "".concat(newTop, "px");
    spider.style.left = "".concat(newLeft, "px");
});

